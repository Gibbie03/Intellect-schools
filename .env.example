# Supabase project credentials (Project Settings > API Keys in the Supabase dashboard)
# Server-side only — never expose the secret key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# Random long string used to sign login session tokens. Generate one with:
#   openssl rand -base64 32
# Changing this invalidates every existing session (forces re-login).
SESSION_SECRET=replace-with-a-long-random-string

# Root domain schools' subdomains live under (e.g. schools get
# <subdomain>.yourplatform.com). Leave unset during rollout to keep the
# current single-tenant behavior; set this once you own a real domain.
PLATFORM_ROOT_DOMAIN=

# Password gating the platform-owner area (/platform) where you onboard
# new schools. Not a per-school password — this is yours only.
PLATFORM_OWNER_PASSWORD=replace-with-a-strong-password
